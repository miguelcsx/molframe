#!/usr/bin/env bash
# Keeps a commit small enough to read.
#
# The soft limit is the one that does the work: it fires while the change is
# still easy to split, rather than after it has become one indivisible blob. The
# hard limit is the backstop, and it has an escape, because a rule with no escape
# gets worked around in ways that are worse than the rule.
#
# Copied into each repository by scripts/sync-hooks.sh.

set -uo pipefail

SOFT_LIMIT=400
HARD_LIMIT=1000
MAX_FILE_BYTES=$((1024 * 1024))

# Lock files are generated wholesale and say nothing about the size of a change.
# Test-fixture data files (PDB coordinates, SPHGEN inputs, etc.) are data, not
# source — counting their lines as if they were code is the wrong axis. Exclude
# them from the LOC budget and rely on the 1 MB file-size check below to keep a
# single fixture from bloating the clone.
is_counted() {
    case "$1" in
        *.lock|*.sum) return 1 ;;
        tests/fixtures/*) return 1 ;;
        *.pdb|*.sphgen|*.sph|*.dat|*.input) return 1 ;;
        *) return 0 ;;
    esac
}

changed=0
staged_files=()

while IFS=$'\t' read -r added removed path; do
    [ -z "${path:-}" ] && continue
    # A binary file reports its counts as '-'.
    [ "$added" = "-" ] && continue
    is_counted "$path" || continue
    changed=$((changed + added + removed))
    staged_files+=("$path")
done < <(git diff --cached --numstat)

# A file large enough to bloat every future clone is almost always accidental.
while IFS= read -r path; do
    [ -z "$path" ] && continue
    [ -f "$path" ] || continue
    size=$(wc -c < "$path")
    if [ "$size" -gt "$MAX_FILE_BYTES" ]; then
        printf '\n\033[31mcommit refused\033[0m: %s is %s bytes\n' "$path" "$size" >&2
        printf '  A file over 1 MB stays in every clone forever.\n' >&2
        printf '  Exclude it, or set ALLOW_LARGE_COMMIT=1 if it genuinely belongs.\n\n' >&2
        [ "${ALLOW_LARGE_COMMIT:-0}" = "1" ] || exit 1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$changed" -gt "$HARD_LIMIT" ]; then
    if [ "${ALLOW_LARGE_COMMIT:-0}" != "1" ]; then
        printf '\n\033[31mcommit refused\033[0m: %s lines staged, over the %s limit\n' \
            "$changed" "$HARD_LIMIT" >&2
        printf '\n  Staged:\n' >&2
        printf '    %s\n' "${staged_files[@]}" >&2
        printf '\n  Commit one coherent unit at a time — a module and its tests.\n' >&2
        printf '  If the change genuinely cannot be split: ALLOW_LARGE_COMMIT=1 git commit ...\n\n' >&2
        exit 1
    fi
    printf '\n\033[33mnote\033[0m: %s lines staged, allowed by ALLOW_LARGE_COMMIT\n\n' "$changed" >&2
elif [ "$changed" -gt "$SOFT_LIMIT" ]; then
    printf '\n\033[33mwarning\033[0m: %s lines staged (soft limit %s)\n' "$changed" "$SOFT_LIMIT" >&2
    printf '  Staged:\n' >&2
    printf '    %s\n' "${staged_files[@]}" >&2
    printf '  Splitting is easier now than after the next change lands on top.\n\n' >&2
fi

exit 0
