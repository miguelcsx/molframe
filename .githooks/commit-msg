#!/usr/bin/env bash
# Validates a commit message before the commit is created.
#
# Lives in git rather than in any agent's configuration, so it holds whoever is
# committing — Claude Code, Codex, Cursor, a script, or a person at a terminal.
# A rule an agent is asked to follow is one it will eventually skip; a rule git
# refuses to violate is not.
#
# Copied into each repository by scripts/sync-hooks.sh. The logic is identical
# everywhere; only .githooks/scopes differs, because the scopes are the parts of
# that particular project.

set -uo pipefail

message_file="${1:?commit-msg hook expects the message file as its argument}"
top_level="$(git rev-parse --show-toplevel)"
scopes_file="$top_level/.githooks/scopes"

subject="$(head -n 1 "$message_file")"

die() {
    printf '\n\033[31mcommit refused\033[0m: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '  %s\n' "$line" >&2
    done
    printf '\n' >&2
    exit 1
}

# A merge, revert or fixup is generated by git and is not ours to reformat.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# One author, always. An agent that adds itself as a co-author is claiming
# authorship of work the repository attributes to one person.
if grep -Eqi '^[[:space:]]*co-authored-by:' "$message_file"; then
    die "the message carries a Co-Authored-By trailer" \
        "This repository records a single author." \
        "Remove the trailer and commit again."
fi

types='feat|fix|refactor|perf|docs|test|build|ci|chore|revert'

if ! printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: .+$"; then
    die "the subject is not a conventional commit" \
        "Wanted:  <type>(<scope>): <subject>" \
        "Types:   ${types//|/, }" \
        "Got:     $subject"
fi

if [ "${#subject}" -gt 72 ]; then
    die "the subject is ${#subject} characters, over the 72 the log can show" \
        "Move the detail into the body, below a blank line." \
        "Got:     $subject"
fi

# The scope is optional, but a scope that is present has to name something real,
# or the log stops being searchable by area.
scope="$(printf '%s' "$subject" | sed -n 's/^[a-z]*(\([a-z0-9-]*\)).*/\1/p')"
if [ -n "$scope" ]; then
    if [ ! -f "$scopes_file" ]; then
        die "the message names scope '$scope' but this repository lists no scopes" \
            "Expected a scope list at .githooks/scopes"
    fi
    if ! grep -Eq "^${scope}$" "$scopes_file"; then
        die "'$scope' is not a scope of this repository" \
            "Known scopes: $(tr '\n' ' ' < "$scopes_file")" \
            "Add it to .githooks/scopes if the project has grown one."
    fi
fi

exit 0
