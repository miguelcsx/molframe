    I32: ColumnKind
    F32: ColumnKind
    SymbolId: ColumnKind

class EncodedColumn:
    @staticmethod
    def plain(values: object, kind: ColumnKind) -> EncodedColumn: ...
    @staticmethod
    def encode(values: object, kind: ColumnKind) -> EncodedColumn: ...
    kind: ColumnKind
    def __len__(self) -> int: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_constant(self) -> bool: ...
    def get(self, position: int) -> object | None: ...
    def to_list(self) -> list[object]: ...
    def iter(self) -> list[object]: ...
    def as_slice(self) -> Any | None: ...
    def __repr__(self) -> str: ...

AtomSelection = Selection

class Position:
    byte_offset: int
    line: int
    column: int
    START: Position
    def __init__(self, byte_offset: int, line: int, column: int) -> None: ...
    def advance(self, byte: int) -> Position | None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

class ByteSpan:
    start: Position
    end: int
    def __init__(self, start: Position, end: int) -> None: ...
    @staticmethod
    def empty(at: Position) -> ByteSpan: ...
    def len(self) -> int | None: ...
    def is_empty(self) -> bool: ...
    def slice(self, source: bytes) -> bytes | None: ...
    def __repr__(self) -> str: ...

class AnnotationColumn:
    @staticmethod
    def boolean(values: list[bool]) -> AnnotationColumn: ...
    @staticmethod
    def integer(values: list[int]) -> AnnotationColumn: ...
    @staticmethod
    def real(values: list[float]) -> AnnotationColumn: ...
    @staticmethod
    def symbol(values: list[SymbolId]) -> AnnotationColumn: ...
    @staticmethod
    def boolean_entries(values: list[bool], presences: list[Presence]) -> AnnotationColumn: ...
    @staticmethod
    def integer_entries(values: list[int], presences: list[Presence]) -> AnnotationColumn: ...
    @staticmethod
    def real_entries(values: list[float], presences: list[Presence]) -> AnnotationColumn: ...
    @staticmethod
    def symbol_entries(values: list[SymbolId], presences: list[Presence]) -> AnnotationColumn: ...
    kind: str
    len: int
    def is_empty(self) -> bool: ...
    def presence(self, atom: int) -> Presence: ...
    def get(self, atom: int) -> tuple[Any, Presence] | None: ...
    values: list[Any]

class Compression:
