class Kind:
    Error: Kind
    Warning: Kind

class Severity:
    Info: Severity
    Loose: Severity
    Strict: Severity
    Invalidating: Severity
    Breaking: Severity
    def is_error(self, strictness: Strictness) -> bool: ...
    label: str

class Strictness:
    Strict: Strictness
    Medium: Strictness
    Loose: Strictness

class Class:
    Syntax: Class
    Schema: Class
    Consistency: Class
    Conversion: Class
    Geometry: Class
    Policy: Class
    Resource: Class
    Internal: Class

class Code:
    def __init__(self, kind: Kind, number: int) -> None: ...
    @staticmethod
    def from_text(text: str) -> Code | None: ...
    @staticmethod
    def registered() -> list[Code]: ...
    kind: Kind
    number: int
    class_: Class
    severity: Severity
    cause: str
    remedy: str
    is_registered: bool
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class ContextItem:
    label: str
    value: str

class Rendered:
    text: str
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Diagnostics:
    def __init__(self, capacity: int = ...) -> None: ...
    def push(self, finding: Diagnostic) -> None: ...
    worst: Severity | None
    def has_error(self, strictness: Strictness) -> bool: ...
    def is_empty(self) -> bool: ...
    def __len__(self) -> int: ...
    def as_list(self) -> list[Diagnostic]: ...
    def finish(self) -> list[Diagnostic]: ...

class ColumnKind:
    U8: ColumnKind
    U16: ColumnKind
    U32: ColumnKind
    U64: ColumnKind
