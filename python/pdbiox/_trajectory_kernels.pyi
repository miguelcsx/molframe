from numpy import float32, float64, uintp
from numpy.typing import NDArray
from ._trajectory_ensemble import EnsembleDistanceMatrix, FrameAlignment, KMeans, KMeansOptions

class MeanSquaredDisplacement:
    lag: int
    observations: int
    value: float

class TrajectoryDielectricOptions:
    def __init__(self, fluctuation_prefactor: float) -> None: ...
    fluctuation_prefactor: float

class DielectricEstimate:
    mean_dipole: tuple[float, float, float]
    covariance: tuple[tuple[float, float, float], tuple[float, float, float], tuple[float, float, float]]
    fluctuation: float
    relative_permittivity: float

def kmeans(observations: NDArray[float64], options: KMeansOptions) -> KMeans: ...
def mean_squared_displacement(frames: NDArray[float32], maximum_lag: int, *, atoms: NDArray[uintp] | None = ...) -> list[MeanSquaredDisplacement]: ...
def dielectric_from_dipoles(dipoles: NDArray[float64], options: TrajectoryDielectricOptions) -> DielectricEstimate: ...
def rmsd_to_reference(frames: NDArray[float32], reference: int, alignment: FrameAlignment) -> list[float]: ...
def pairwise_fitted_rmsd(frames: NDArray[float32], memory_limit: int = ...) -> EnsembleDistanceMatrix: ...
def pairwise_torus_distance(points: NDArray[float64], weights: NDArray[float64], memory_limit: int = ...) -> EnsembleDistanceMatrix: ...
def generalized_procrustes_mean(frames: NDArray[float32], tolerance: float, maximum_iterations: int) -> NDArray[float32]: ...
