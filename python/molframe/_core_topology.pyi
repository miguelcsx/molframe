class AtomRecord:
    def __init__(self, position: tuple[float, float, float] | None, element: Element,
                 atom_name: SymbolId, auth_atom_name: OptionalSymbol,
                 alternate_component_id: OptionalSymbol, alt_id: AltId, residue: ResidueIndex,
                 occupancy: tuple[float, Presence], b_factor: tuple[float, Presence],
                 formal_charge: tuple[int, Presence], atom_site_id: int) -> None: ...
    position: tuple[float, float, float] | None
    element: Element
    atom_name: SymbolId
    auth_atom_name: OptionalSymbol
    alternate_component_id: OptionalSymbol
    alt_id: AltId
    residue: ResidueIndex
    occupancy: tuple[float, Presence]
    b_factor: tuple[float, Presence]
    formal_charge: tuple[int, Presence]
    atom_site_id: int

class AtomChunk:
    def __len__(self) -> int: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    atoms: tuple[int, int]
    model: int
    stats: AtomChunkStats
    def positions(self, coords: CoordinateBlock) -> Any: ...
    def element(self, local: int) -> Element | None: ...
    def atom_name(self, local: int) -> SymbolId | None: ...
    def atom_names_plain(self) -> list[SymbolId] | None: ...
    def auth_atom_name(self, local: int) -> SymbolId | None: ...
    def alternate_component_id(self, local: int) -> SymbolId | None: ...
    def alt_id(self, local: int) -> AltId | None: ...
    def residue(self, local: int, residues: ResidueTable) -> ResidueIndex | None: ...
    def occupancy(self, local: int) -> tuple[float, Presence] | None: ...
    def occupancies_plain(self) -> Any: ...
    def b_factor(self, local: int) -> tuple[float, Presence] | None: ...
    def b_factors_plain(self) -> Any: ...
    def formal_charge(self, local: int) -> tuple[int, Presence] | None: ...
    def atom_site_id(self, local: int) -> int | None: ...
    def has_position(self, local: int) -> bool: ...
    def record(self, local: int, residues: ResidueTable,
               position: tuple[float, float, float] | None = ...) -> AtomRecord | None: ...

