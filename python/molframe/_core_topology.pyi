class DictionaryFull(ValueError): ...

class CoordinateBlock:
    def __init__(self) -> None: ...
    @staticmethod
    def with_capacity(positions: int) -> CoordinateBlock: ...
    len: int
    positions: Any
    def is_empty(self) -> bool: ...
    def push(self, position: tuple[float, float, float]) -> None: ...
    def range(self, start: int, end: int) -> Any: ...
    def bounds(self, start: int, end: int) -> Aabb: ...
    def allocated_bytes(self) -> int: ...
    def as_slice(self) -> Any: ...

class BitVec:
    def __init__(self) -> None: ...
    @staticmethod
    def repeat(value: bool, length: int) -> BitVec: ...
    @staticmethod
    def with_capacity(length: int) -> BitVec: ...
    @staticmethod
    def from_values(values: list[bool]) -> BitVec: ...
    @staticmethod
    def try_from_iter(values: list[bool]) -> BitVec: ...
    len: int
    def is_empty(self) -> bool: ...
    def try_push(self, value: bool) -> None: ...
    def get(self, position: int) -> bool | None: ...
    def test(self, position: int) -> bool: ...
    def set(self, position: int, value: bool) -> None: ...
    def count_ones(self) -> int: ...
    def all(self) -> bool: ...
    def none(self) -> bool: ...
    def ones(self) -> list[int]: ...
    def intersect_with(self, other: BitVec) -> None: ...
    def union_with(self, other: BitVec) -> None: ...
    def invert(self) -> None: ...

class Presence:
    Present: Presence
    Unknown: Presence
    Inapplicable: Presence
    def is_present(self) -> bool: ...

class ValidityMask:
    @staticmethod
    def all_present(length: int) -> ValidityMask: ...
    @staticmethod
    def from_values(values: list[Presence]) -> ValidityMask: ...
    @staticmethod
    def try_from_iter(values: list[Presence]) -> ValidityMask: ...
    len: int
    def is_empty(self) -> bool: ...
    def is_all_present(self) -> bool: ...
    def get(self, position: int) -> Presence: ...
    def set(self, position: int, presence: Presence) -> None: ...
    def present_count(self) -> int: ...
    def compact(self) -> None: ...

def bit_width(maximum: int) -> int: ...
