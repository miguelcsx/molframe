@final
class ArrowStream:
    consumed: bool
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    def __repr__(self) -> str: ...

@final
class AtomArrowTable:
    def __init__(self, structure: Structure) -> None: ...
    def schema(self) -> object: ...
    def record_batches(self) -> list[object]: ...
    def arrow_stream(self) -> ArrowStream: ...
    def __repr__(self) -> str: ...

@final
class ResidueArrowTable:
    def __init__(self, structure: Structure) -> None: ...
    def schema(self) -> object: ...
    def record_batches(self) -> list[object]: ...
    def arrow_stream(self) -> ArrowStream: ...
    def __repr__(self) -> str: ...

@final
class ChainArrowTable:
    def __init__(self, structure: Structure) -> None: ...
    def schema(self) -> object: ...
    def record_batches(self) -> list[object]: ...
    def arrow_stream(self) -> ArrowStream: ...
    def __repr__(self) -> str: ...

@final
class BondArrowTable:
    def __init__(self, structure: Structure) -> None: ...
    def schema(self) -> object: ...
    def record_batches(self) -> list[object]: ...
    def arrow_stream(self) -> ArrowStream: ...
    def __repr__(self) -> str: ...

AtomTable = AtomArrowTable
BondTable = BondArrowTable
ChainTable = ChainArrowTable
ResidueTable = ResidueArrowTable

@final
class DLDevice:
    def __init__(self, device_type: int, device_id: int) -> None: ...
    device_type: int
    device_id: int

@final
class DLDataType:
    def __init__(self, code: int, bits: int, lanes: int) -> None: ...
    code: int
    bits: int
    lanes: int

@final
class DLTensor:
    def __init__(self, data_address: int, device: DLDevice, ndim: int, dtype: DLDataType, shape: list[int], *, strides: list[int] | None = None, byte_offset: int = 0) -> None: ...
    data_address: int
    device: DLDevice
    ndim: int
    dtype: DLDataType
    shape: list[int]
    strides: list[int] | None
    byte_offset: int

@final
class DLManagedTensor:
    tensor: DLTensor
    manager_context_address: int
    has_deleter: bool

@final
class DlpackTensor:
    @staticmethod
    def coordinates(structure: Structure) -> DlpackTensor: ...
    cost: ExportCost
    managed: DLManagedTensor | None
    consumed: bool
