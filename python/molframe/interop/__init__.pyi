@final
class DatasetEntry:
    def __init__(self, id: str, path: str | PathLike[str], atom_count: int, *, resolution: float | None = None, method: str | None = None, deposition_date: str | None = None, sequence: str | None = None, structure_cluster: str | None = None, tags: list[str] = [], statistics: dict[str, float] | None = None) -> None: ...
    @property
    def id(self) -> str: ...
    @property
    def path(self) -> PathLike[str]: ...
    @property
    def atom_count(self) -> int: ...
    @property
    def resolution(self) -> float | None: ...
    @property
    def method(self) -> str | None: ...
    @property
    def deposition_date(self) -> str | None: ...
    @property
    def sequence(self) -> str | None: ...
    @property
    def structure_cluster(self) -> str | None: ...
    @property
    def tags(self) -> list[str]: ...
    @property
    def statistics(self) -> dict[str, float]: ...
    def __repr__(self) -> str: ...

ManifestEntry = DatasetEntry

@final
class DatasetFilter:
    def __init__(self, *, resolution_below: float | None = None, method: str | None = None, minimum_atoms: int | None = None, maximum_atoms: int | None = None, tag: str | None = None) -> None: ...
    resolution_below: float | None
    method: str | None
    minimum_atoms: int | None
    maximum_atoms: int | None
    tag: str | None

@final
class SplitRatios:
    def __init__(self, train: float, validation: float, test: float) -> None: ...
    train: float
    validation: float
    test: float
    def __repr__(self) -> str: ...

@final
class SplitOptions:
    def __init__(self, strategy: SplitStrategy, *, ratios: SplitRatios | None = None, train: float = 0.8, validation: float = 0.1, test: float = 0.1) -> None: ...
    strategy: SplitStrategy
    ratios: SplitRatios

@final
class SplitStrategy:
    @staticmethod
    def sequence_identity(threshold: float) -> SplitStrategy: ...
    @staticmethod
    def structural_cluster() -> SplitStrategy: ...
    @staticmethod
    def temporal() -> SplitStrategy: ...
    @staticmethod
    def random(seed: int) -> SplitStrategy: ...

@final
class DatasetWarning:
    RandomSplitMayLeak: DatasetWarning

@final
class Dataset:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def from_entries(entries: list[DatasetEntry]) -> Dataset: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def __getitem__(self, index: int) -> DatasetEntry: ...
    def load(self, index: int) -> Structure: ...
    def filter(
        self,
        *,
        resolution_below: float | None = None,
        method: str | None = None,
        minimum_atoms: int | None = None,
        maximum_atoms: int | None = None,
        tag: str | None = None,
    ) -> Dataset: ...
    def filter_spec(self, filter: DatasetFilter) -> Dataset: ...
    def split(
        self,
        strategy: SplitStrategy,
        *,
        train: float = 0.8,
        validation: float = 0.1,
        test: float = 0.1,
    ) -> DatasetSplit: ...
    def split_options(self, options: SplitOptions) -> DatasetSplit: ...
    def batches(self, batch_size: int) -> list[Dataset]: ...

@final
class DatasetSplit:
    @property
    def train(self) -> Dataset: ...
    @property
    def validation(self) -> Dataset: ...
    @property
    def test(self) -> Dataset: ...
    @property
    def warnings(self) -> list[DatasetWarning]: ...

