@final
class MemoryReader:
    def __init__(self, trajectory: Trajectory) -> None: ...
    @staticmethod
    def from_frames(frames: list[Timestep]) -> MemoryReader: ...
    @property
    def n_atoms(self) -> int: ...
    @property
    def n_frames(self) -> int: ...
    @property
    def units(self) -> Units: ...
    @property
    def random_access(self) -> RandomAccess: ...
    def read_next(self) -> Timestep | None: ...
    def read_all(self) -> list[Timestep]: ...
    def seek(self, frame: int) -> None: ...
    def rewind(self) -> None: ...

@final
class StreamingReader:
    def __init__(self, frames: list[Frame], *, atom_count: int | None = ...) -> None: ...
    @property
    def n_atoms(self) -> int: ...
    @property
    def n_frames(self) -> None: ...
    @property
    def units(self) -> Units: ...
    @property
    def random_access(self) -> RandomAccess: ...
    def read_next(self) -> Timestep | None: ...
    def seek(self, frame: int) -> None: ...
    def rewind(self) -> None: ...

@final
class ChainedReader:
    def __init__(self, readers: list[MemoryReader]) -> None: ...
    @property
    def n_atoms(self) -> int: ...
    @property
    def n_frames(self) -> int | None: ...
    @property
    def random_access(self) -> RandomAccess: ...
    def read_next(self) -> Timestep | None: ...
    def seek(self, frame: int) -> None: ...

