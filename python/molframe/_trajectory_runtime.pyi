@final
class TrajectoryUnits:
    def __init__(
        self,
        length: tuple[str, float],
        time: tuple[str, float],
        velocity: tuple[str, float],
        force: tuple[str, float],
    ) -> None: ...
    @staticmethod
    def canonical() -> TrajectoryUnits: ...
    @property
    def length_unit(self) -> str: ...
    @property
    def length_to_angstrom(self) -> float: ...
    @property
    def time_unit(self) -> str: ...
    @property
    def time_to_picosecond(self) -> float: ...
    @property
    def velocity_unit(self) -> str: ...
    @property
    def velocity_to_angstrom_per_picosecond(self) -> float: ...
    @property
    def force_unit(self) -> str: ...
    @property
    def force_to_kilojoule_per_mole_angstrom(self) -> float: ...

@final
class TrajectoryWriteOptions:
    @staticmethod
    def xtc(*, precision: float | None = None) -> TrajectoryWriteOptions: ...
    @staticmethod
    def trr(*, double_precision: bool = False) -> TrajectoryWriteOptions: ...
    @staticmethod
    def dcd(
        *,
        little_endian: bool | None = None,
        title: str | None = None,
        start_step: int | None = None,
        save_interval: int | None = None,
        delta_akma: float | None = None,
    ) -> TrajectoryWriteOptions: ...
    @staticmethod
    def amber_netcdf(*, double_precision: bool = False) -> TrajectoryWriteOptions: ...
    @staticmethod
    def tng(
        *,
        distance_unit_exponent: int | None = None,
        lossy_precision: float | None = None,
        hashes: bool | None = None,
    ) -> TrajectoryWriteOptions: ...
    @staticmethod
    def gsd(length_to_angstrom: float) -> TrajectoryWriteOptions: ...
    @staticmethod
    def h5md(
        *,
        particle_group: str | None = None,
        units: TrajectoryUnits | None = None,
    ) -> TrajectoryWriteOptions: ...
    @staticmethod
    def trz() -> TrajectoryWriteOptions: ...

@final
class Trajectory:
    def __repr__(self) -> str: ...
    def __init__(
        self,
        xyz: NDArray[float32],
        *,
        time: NDArray[float64] | None = None,
        velocities: NDArray[float32] | None = None,
        forces: NDArray[float32] | None = None,
        cells: NDArray[float64] | None = None,
        steps: NDArray[int64] | None = None,
        copy: bool = False,
    ) -> None: ...
    def __len__(self) -> int: ...
    @staticmethod
    def read(
        path: str | PathLike[str],
        *,
        format: TrajectoryFormat | None = None,
        length_to_angstrom: float | None = None,
        particle_group: str | None = None,
        units: TrajectoryUnits | None = None,
    ) -> Trajectory: ...
    def write(
        self,
        path: str | PathLike[str],
        *,
        options: TrajectoryWriteOptions | None = None,
    ) -> None: ...
    @property
    def atom_count(self) -> int: ...
    @property
    def is_view(self) -> bool: ...
    @property
    def format(self) -> TrajectoryFormat | None: ...
    @property
    def xyz(self) -> NDArray[float32]: ...
    @property
    def velocities(self) -> NDArray[float32] | None: ...
    @property
    def forces(self) -> NDArray[float32] | None: ...
    @property
    def time(self) -> NDArray[float64] | None: ...
    @property
    def dt(self) -> NDArray[float64] | None: ...
    @property
    def cells(self) -> NDArray[float64] | None: ...
    @property
    def steps(self) -> NDArray[int64] | None: ...
    @property
    def precision(self) -> NDArray[float64] | None: ...
    @staticmethod
    def from_frames(frames: list[Frame]) -> Trajectory: ...
    def frame(self, index: int) -> Frame | None: ...
    def frames(self) -> list[Frame]: ...
    def slice(self, indices: list[int]) -> Trajectory: ...

